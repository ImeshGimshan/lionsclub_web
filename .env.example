# Copy to .env.local. The project ID and dataset are public values.
NEXT_PUBLIC_SANITY_PROJECT_ID=zhxlfgcp
NEXT_PUBLIC_SANITY_DATASET=production

# Shared secret for the Sanity "publish" webhook that calls /api/revalidate.
# Generate a long random string and use the same value in sanity.io/manage → API → Webhooks.
SANITY_REVALIDATE_SECRET=

# Server-only Editor token for the enquiry form (writes to the private "enquiries" dataset).
# Create with: cd studio && npx sanity tokens add "Website enquiry form (server only)" --role=editor
SANITY_ENQUIRIES_WRITE_TOKEN=
